# Mealy worker environment — copy to .env and fill in. Never commit real keys.

# Anthropic API key (structuring brain, claude-haiku-4-5)
ANTHROPIC_API_KEY=

# OpenAI API key (reel audio transcription, gpt-4o-mini-transcribe)
OPENAI_API_KEY=

# Supabase project JWT secret (Dashboard → Settings → API → JWT Secret).
# Used to verify user access tokens (HS256, audience "authenticated").
SUPABASE_JWT_SECRET=

# Optional: Netscape-format cookie jar for yt-dlp (logged-in Instagram/TikTok)
YTDLP_COOKIES_FILE=
